{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Miyu release input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assets",
    "builders",
    "builds",
    "channels",
    "checks",
    "fedora_version",
    "locks",
    "mode",
    "package_revision",
    "profile",
    "release_declaration",
    "schema_version",
    "source_commit",
    "source_date_epoch",
    "source_dirty",
    "source_snapshot_sha256",
    "tag",
    "tag_commit",
    "targets",
    "toolchain",
    "version",
    "wiki_commit",
    "workflow_commit"
  ],
  "properties": {
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "filename",
          "build_id",
          "component",
          "format",
          "arch"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "filename": {
            "type": "string",
            "pattern": "^[^/\\\\\\r\\n]+$"
          },
          "build_id": {
            "enum": [
              "gnu-x86_64",
              "arch-x86_64",
              "macos-arm64"
            ]
          },
          "component": {
            "enum": [
              "core",
              "voice"
            ]
          },
          "format": {
            "enum": [
              "deb",
              "rpm",
              "archlinux",
              "tar.gz"
            ]
          },
          "arch": {
            "enum": [
              "amd64",
              "x86_64",
              "arm64"
            ]
          }
        }
      }
    },
    "builders": {
      "type": "object",
      "minProperties": 1
    },
    "builds": {
      "type": "object",
      "minProperties": 1
    },
    "channels": {
      "type": "object",
      "minProperties": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "target",
          "check",
          "required"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "target": {
            "enum": [
              "arch-x86_64",
              "debian13-x86_64",
              "ubuntu2404-x86_64",
              "ubuntu2604-x86_64",
              "mint22-x86_64",
              "fedora-current-x86_64",
              "macos-arm64"
            ]
          },
          "check": {
            "type": "string"
          },
          "required": {
            "const": true
          }
        }
      }
    },
    "fedora_version": {
      "type": "integer",
      "minimum": 1
    },
    "locks": {
      "type": "object",
      "required": [
        "cargo",
        "toolchain",
        "third_party",
        "assets",
        "targets"
      ],
      "additionalProperties": false,
      "properties": {
        "cargo": {
          "$ref": "#/$defs/sha256"
        },
        "toolchain": {
          "$ref": "#/$defs/sha256"
        },
        "third_party": {
          "$ref": "#/$defs/sha256"
        },
        "assets": {
          "$ref": "#/$defs/sha256"
        },
        "targets": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "mode": {
      "enum": [
        "preview",
        "release"
      ]
    },
    "package_revision": {
      "type": "integer",
      "minimum": 1
    },
    "profile": {
      "enum": [
        "preview-core",
        "stable-core",
        "stable-full",
        "linux-smoke",
        "smoke"
      ]
    },
    "release_declaration": {
      "type": [
        "object",
        "null"
      ]
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "source_commit": {
      "$ref": "#/$defs/sha1"
    },
    "source_date_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "source_dirty": {
      "type": "boolean"
    },
    "source_snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "tag_commit": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha1"
        },
        {
          "type": "null"
        }
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "arch-x86_64",
          "debian13-x86_64",
          "ubuntu2404-x86_64",
          "ubuntu2604-x86_64",
          "mint22-x86_64",
          "fedora-current-x86_64",
          "macos-arm64"
        ]
      }
    },
    "toolchain": {
      "type": "object",
      "minProperties": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "wiki_commit": {
      "$ref": "#/$defs/sha1"
    },
    "workflow_commit": {
      "$ref": "#/$defs/sha1"
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
